  key: smelt
  title: "\uC81C\uB828"
  real: "\uAD11\uC11D \u2192 \uBE14\uB8F8 \xB7 \uC2E4\uC81C \uC57D 1\uC77C"
  blurb: "\uC22F\uACFC \uAD11\uC11D\uC744 \uB178\uC5D0 \uBC88\uAC08\uC544 \uB123\uACE0 \uD480\uBB34\uB85C \uBC14\uB78C\uC744 \uBCF4\uB0C5\uB2C8\uB2E4. 1,100~1,200\u2103\uB97C \uB118\uACA8\uC57C \uC2AC\uB798\uADF8\uAC00 \uB179\uC544 \uCCA0\uACFC \uBD84\uB9AC\uB429\uB2C8\uB2E4. \uB179\uC740 \uC2AC\uB798\uADF8\uB294 \uB178 \uC544\uB798 \uBC30\uCD9C\uAD6C\uB97C \uB6AB\uC5B4 \uC5EC\uB7EC \uBC88 \uD758\uB824\uBCF4\uB0C5\uB2C8\uB2E4."
  controls: "\u2460 \uD480\uBB34\uC9C8: \uD480\uBB34 \uBC84\uD2BC(\uB610\uB294 \uC2A4\uD398\uC774\uC2A4)\uC744 \uB204\uB974\uACE0 \uC788\uC73C\uBA74 \uBD88\uC774 \uC138\uC9C0\uACE0, \uB5BC\uBA74 \uC2DD\uC2B5\uB2C8\uB2E4. \uC628\uB3C4\uACC4\uC758 \uAE08\uC0C9 \uAD6C\uAC04\uC5D0 \uC624\uB798 \uBA38\uBB3C\uC218\uB85D \uC810\uC218\uAC00 \uB192\uC544\uC694. \u2461 \uC2AC\uB798\uADF8 \uBC30\uCD9C: \uB179\uC740 \uC2AC\uB798\uADF8\uAC00 \uCC28\uC624\uB974\uBA74 \uBC30\uCD9C\uAD6C\uB97C \uB6AB\uC5B4 \uD758\uB824\uBCF4\uB0C5\uB2C8\uB2E4."
