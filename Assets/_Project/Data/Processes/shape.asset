  key: shape
  title: "\uCE7C\uB0A0 \uB2E8\uC870"
  real: "\uCCA0 \uBC14 \u2192 \uCE7C\uB0A0 \uD615\uC0C1 \xB7 \uB9C8\uD06C \xB7 \uBD88\uB9BC \xB7 \uC2E4\uC81C \uC57D 1\uC77C"
  blurb: "\uB9C8\uB984\uBAA8 \uB2E8\uBA74\uACFC \uB0A0\uB05D\uC744 \uB9CC\uB4ED\uB2C8\uB2E4. \uB2EC\uAD70 \uC1E0\uB97C \uB9DD\uCE58\uB85C \uCCD0\uC11C \uAC00\uC6B4\uB370 \uB2A5\uC120\uC744 \uC138\uC6B0\uACE0, \uB05D\uC73C\uB85C \uAC08\uC218\uB85D \uC1A1\uACF3\uCC98\uB7FC \uAC00\uB298\uAC8C \uB298\uB9BD\uB2C8\uB2E4. \uB728\uAC70\uC6B8 \uB54C \uD380\uCE58\uB85C \uC81C\uC791\uC790 \uB9C8\uD06C\uB97C \uCC0D\uACE0, \uCCB4\uB9AC\uBE5B\uAE4C\uC9C0 \uB370\uC6E0\uB2E4 \uACF5\uAE30 \uC911\uC5D0 \uC2DD\uD788\uB294 \uBD88\uB9BC\uC744 2~3\uBC88 \uD574\uC11C \uC751\uB825\uC744 \uD489\uB2C8\uB2E4."
  controls: "\u2460 \uD615\uC0C1: \uB5A8\uB9AC\uB294 \uC870\uC900\uC810\uC744 \uBE5B\uB098\uB294 \uD45C\uC801 \uC704\uC5D0 \uB9DE\uCDB0 \uD074\uB9AD\uD569\uB2C8\uB2E4. \uCE7C\uC774 \uC2DD\uAE30 \uC804\uC5D0 \uB178\uC5D0 \uB2E4\uC2DC \uB123\uC73C\uC138\uC694. \u2461 \uB9C8\uD06C \uAC01\uC778: \uD380\uCE58\uB97C \uB450 \uBC88 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uCE69\uB2C8\uB2E4. \u2462 \uBD88\uB9BC: \uCCB4\uB9AC\uBE5B\uC5D0\uC11C \uB5BC\uACE0 \uAC80\uAC8C \uC2DD\uC744 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9AC\uAE30\uB97C 3\uBC88."
