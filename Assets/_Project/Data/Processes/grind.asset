  key: grind
  title: "\uC5F0\uB9C8"
  real: "\uC22B\uB3CC \uAC08\uAE30 \xB7 \uB0A0 \uC138\uC6B0\uAE30 \xB7 \uC2E4\uC81C \uC57D 1~2\uC77C"
  blurb: "\uD06C\uB7AD\uD06C\uB85C \uB3CC\uB9AC\uB294 \uC0AC\uC554 \uC22B\uB3CC\uC5D0 \uCE7C\uB0A0\uC744 \uB300\uACE0 \uB0A0 \uC120\uC744 \uAC08\uC544 \uBAA8\uC591\uC744 \uB9DE\uCDA5\uB2C8\uB2E4. \uACFC\uC5F4\uB418\uBA74 \uB728\uC784\uC774 \uD480\uB9AC\uBBC0\uB85C \uBB3C\uC744 \uBB3B\uD600 \uAC00\uBA70 \uAC11\uB2C8\uB2E4. \uB9C8\uC9C0\uB9C9\uC5D0 \uC190\uC22B\uB3CC\uB85C \uB0A0\uC744 \uC138\uC6C1\uB2C8\uB2E4."
  controls: "\u2460 \uC22B\uB3CC \uAC08\uAE30: \uC22B\uB3CC \uC704\uB97C \uB204\uB978 \uCC44 \uC6D0\uC744 \uADF8\uB824 \uD06C\uB7AD\uD06C\uB97C \uB3CC\uB9AC\uACE0, \uB0A0\uC774 \uB2EC\uC544\uC624\uB974\uBA74 \uBB3C\uC744 \uCC0D\uC2B5\uB2C8\uB2E4. \u2461 \uB0A0 \uC138\uC6B0\uAE30: \uC190\uC22B\uB3CC\uC744 \uBFCC\uB9AC\uC5D0\uC11C \uB0A0\uB05D\uAE4C\uC9C0 \uB0A0 \uC120\uC744 \uB530\uB77C \uD55C \uBC88\uC5D0 \uBC09\uB2C8\uB2E4."
