  key: sheath
  title: "\uCE7C\uC9D1"
  real: "\uAC00\uC8FD \uC131\uD615 \xB7 \uB3C4\uC7A5 \xB7 \uBC14\uB290\uC9C8 \xB7 \uC2E4\uC81C \uC57D 1\uC77C"
  blurb: "\uBB34\uB450\uC9C8\uD55C \uC1A1\uC544\uC9C0 \uAC00\uC8FD\uC73C\uB85C \uCE7C\uC744 \uAC10\uC2F8 \uBAA8\uC591\uC744 \uC7A1\uACE0, \uB4F1 \uC194\uAE30\uB97C \uAFF0\uB9F5\uB2C8\uB2E4. \uC816\uC740 \uAC00\uC8FD\uC5D0 \uB3C4\uC7A5\uC744 \uCC0D\uC5B4 \uC7A5\uC2DD\uC744 \uB123\uC2B5\uB2C8\uB2E4."
  controls: "\u2460 \uAC00\uC8FD \uC131\uD615: \uAC00\uC8FD\uC774 \uB9C8\uB974\uAE30 \uC804\uC5D0 \uCE7C \uC724\uACFD\uC120\uC744 \uB530\uB77C \uBB38\uC9C8\uB7EC \uBAA8\uC591\uC744 \uC7A1\uC2B5\uB2C8\uB2E4. \u2461 \uB3C4\uC7A5 \uAFB8\uBBF8\uAE30: \uC88C\uC6B0 \uB300\uCE6D \xB7 \uACE0\uB978 \uAC04\uACA9\uC73C\uB85C \uB3C4\uC7A5\uC744 \uCC0D\uC2B5\uB2C8\uB2E4. \u2462 \uB9AC\uB4EC \uBC14\uB290\uC9C8: \uBC15\uC790\uAC00 \uAE08\uC0C9 \uC120\uC5D0 \uB2FF\uC744 \uB54C \uCC0C\uB974\uAE30 \xB7 \uB2F9\uAE30\uAE30\uB97C \uBC88\uAC08\uC544 \uB204\uB985\uB2C8\uB2E4."
